#!/usr/bin/env bash
# vxwm-dotfiles installer V4 (Artix Linux / dinit / X11)
# Changelog V4:
#   - Idempotent: if vxwm binary + dotfiles already present, skip install
#   - Only (re)generates ~/.local/share/applications/vxwm.desktop on re-run
#   - --force flag to override skip and do full reinstall
#   - Layered soft-fail (no set -e) for all package sections
#   - Corrected turnstiled workflow (enable, then user re-login)

set -uo pipefail

REPO_URL="https://github.com/ceapeapea/vxwm-dotfiles.git"
DOTFILES_DIR="$HOME/dotfiles"
BIN_PATH="$HOME/.local/bin/vxwm"
DESKTOP_DIR="$HOME/.local/share/applications"
DESKTOP_FILE="$DESKTOP_DIR/vxwm.desktop"
FORCE=0

# Parse args
for arg in "$@"; do
    case "$arg" in
        --force|-f) FORCE=1 ;;
        *) echo "Unknown arg: $arg"; exit 1 ;;
    esac
done

# ─────────────────────────────────────────────────────────────
# Detect existing install
# ─────────────────────────────────────────────────────────────
ALREADY_INSTALLED=0
if [[ -x "$BIN_PATH" && -d "$DOTFILES_DIR/vxwm" && -f "$HOME/.xinitrc" ]]; then
    ALREADY_INSTALLED=1
fi

if [[ "$ALREADY_INSTALLED" -eq 1 && "$FORCE" -eq 0 ]]; then
    echo "==> vxwm already installed (binary + dotfiles + .xinitrc found)."
    echo "    Skipping full install. Only refreshing .desktop file."
    echo "    (Use --force to reinstall everything.)"
    SKIP_INSTALL=1
else
    SKIP_INSTALL=0
fi

# ─────────────────────────────────────────────────────────────
# Helper: write .desktop file
# ─────────────────────────────────────────────────────────────
write_desktop_file() {
    mkdir -p "$DESKTOP_DIR"
    cat > "$DESKTOP_FILE" <<'EOF'
[Desktop Entry]
Type=Application
Name=vxwm
Comment=Lightweight X11 window manager (vxwm-dotfiles)
Exec=/home/USER/.local/bin/vxwm
TryExec=/home/USER/.local/bin/vxwm
Icon=utilities-terminal
Terminal=false
Categories=System;WindowManager;
StartupNotify=false
X-Dinit-Managed=false
EOF
    # Substitute real $HOME (heredoc above is quoted, so no expansion)
    sed -i "s|/home/USER|$HOME|g" "$DESKTOP_FILE"
    chmod 644 "$DESKTOP_FILE"
    echo "    Wrote $DESKTOP_FILE"
}

# ─────────────────────────────────────────────────────────────
# Fast path: skip install, only refresh .desktop
# ─────────────────────────────────────────────────────────────
if [[ "$SKIP_INSTALL" -eq 1 ]]; then
    write_desktop_file
    command -v update-desktop-database >/dev/null 2>&1 && \
        update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
    echo ""
    echo "==> Done (desktop entry refreshed)."
    exit 0
fi

# ─────────────────────────────────────────────────────────────
# Full install path
# ─────────────────────────────────────────────────────────────
echo "==> vxwm-dotfiles installer V4 (full install)"

# 1. Clone repo
if [[ ! -d "$DOTFILES_DIR" ]]; then
    echo "==> Cloning dotfiles..."
    git clone "$REPO_URL" "$DOTFILES_DIR" || { echo "!!! git clone failed"; exit 1; }
else
    echo "==> Dotfiles exist at $DOTFILES_DIR, skipping clone."
fi
cd "$DOTFILES_DIR" || exit 1

# 2. Core X11 + build deps (hard fail)
echo "==> Installing core X11 + build dependencies..."
sudo pacman -S --needed --noconfirm \
    base-devel git pkgconf make rsync python-pip \
    xorg-server xorg-xinit xorg-xrdb xorg-xsetroot \
    xorg-xset xorg-xprop xorg-setxkbmap xorg-xrandr \
    xdotool \
    libx11 libxft libxinerama \
    libxcomposite libxdamage libxfixes libxrandr libdrm \
    fontconfig freetype2 \
    || { echo "!!! Core X11 deps failed — aborting"; exit 1; }

# 3. Turnstile infrastructure
echo "==> Installing turnstile + dbus user session..."
sudo pacman -S --needed --noconfirm \
    turnstile turnstile-dinit dbus-dinit-user \
    || echo "!!! turnstile install failed"

echo "==> Enabling turnstiled..."
sudo dinitctl enable turnstiled 2>&1 || \
    echo "!!! turnstiled enable failed — retry after re-login"

if [[ -e /run/turnstiled ]]; then
    echo "    /run/turnstiled exists."
else
    echo "    /run/turnstiled missing — log out/in required."
fi

# 4. Desktop packages (soft-fail; no AUR-only packages)
echo "==> Installing desktop packages..."
sudo pacman -S --needed --noconfirm \
    kitty feh dmenu stalonetray picom dunst libnotify \
    thunar gvfs exo tumbler sxiv imagemagick \
    xclip xsel micro brightnessctl slock \
    network-manager-applet \
    bluez bluez-utils blueman \
    libpulse pipewire pipewire-pulse pipewire-alsa pipewire-jack wireplumber \
    pavucontrol alsa-utils python-gobject gtk3 \
    udisks2 ntfs-3g xdg-user-dirs xdg-utils \
    ttf-dejavu ttf-liberation noto-fonts \
    python-pywal \
    || echo "!!! Some desktop packages failed"

echo "==> Installing optional nerd fonts (soft-fail)..."
sudo pacman -S --needed --noconfirm \
    otf-atkinsonhyperlegiblemono-nerd \
    ttf-jetbrains-mono-nerd ttf-firacode-nerd ttf-hack-nerd \
    2>/dev/null || echo "    (some nerd fonts unavailable)"

# 5. dinit service packages
echo "==> Installing dinit service packages..."
sudo pacman -S --needed --noconfirm \
    networkmanager-dinit bluez-dinit \
    pipewire-dinit pipewire-pulse-dinit wireplumber-dinit \
    || echo "!!! Some dinit service packages failed"

# 6. Build vxwm
echo "==> Building vxwm..."
cd "$DOTFILES_DIR/vxwm" || exit 1
make clean && make || { echo "!!! vxwm build failed"; exit 1; }
sudo make install
mkdir -p "$(dirname "$BIN_PATH")"
cp -f ./vxwm "$BIN_PATH"
chmod +x "$BIN_PATH"

mkdir -p "$HOME/vxwm"
rsync -a --delete --exclude='*.o' --exclude='vxwm' --exclude='.git' \
    "$DOTFILES_DIR/vxwm/" "$HOME/vxwm/"

# 7. Install configs
echo "==> Installing configs..."
mkdir -p "$(dirname "$BIN_PATH")" "$HOME/.config"
mkdir -p "$HOME/Pictures/Wallpapers" "$HOME/Pictures/Screenshots" "$HOME/.cache/clipmenu"
mkdir -p "$HOME/.config"/{kitty,picom,dunst,wal/templates,gtk-3.0,rice,fontconfig/conf.d}

cp "$DOTFILES_DIR/.local/bin/"* "$(dirname "$BIN_PATH")/" && chmod +x "$(dirname "$BIN_PATH")/"*
cp "$DOTFILES_DIR/.config/kitty/kitty.conf" "$HOME/.config/kitty/"
cp "$DOTFILES_DIR/.config/picom/picom.conf" "$HOME/.config/picom/"
cp "$DOTFILES_DIR/.config/dunst/dunstrc" "$HOME/.config/dunst/dunstrc.base"
cp "$DOTFILES_DIR/.config/dunst/dunstrc" "$HOME/.config/dunst/dunstrc"
cp "$DOTFILES_DIR/.config/wal/templates/"* "$HOME/.config/wal/templates/" 2>/dev/null || true
cp "$DOTFILES_DIR/.config/gtk-3.0/"* "$HOME/.config/gtk-3.0/"
cp "$DOTFILES_DIR/.config/rice/"* "$HOME/.config/rice/" 2>/dev/null || true
cp "$DOTFILES_DIR/.config/fontconfig/conf.d/"* "$HOME/.config/fontconfig/conf.d/" 2>/dev/null || true

cp "$DOTFILES_DIR/.xinitrc" "$HOME/.xinitrc" && chmod +x "$HOME/.xinitrc"
cp "$DOTFILES_DIR/.stalonetrayrc" "$HOME/.stalonetrayrc"

[[ -f "$HOME/.bashrc" ]] && cp "$HOME/.bashrc" "$HOME/.bashrc.bak"
cp "$DOTFILES_DIR/.bashrc" "$HOME/.bashrc"

cp -a "$DOTFILES_DIR/Pictures/Wallpapers/." "$HOME/Pictures/Wallpapers/" 2>/dev/null || true
xdg-mime default thunar.desktop inode/directory 2>/dev/null || true

if ! grep -q 'local/bin' "$HOME/.profile" 2>/dev/null; then
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.profile"
fi

# 8. System services only
echo "==> Enabling system services..."
sudo dinitctl enable networkmanager 2>/dev/null || echo "    networkmanager enable failed"
sudo dinitctl enable bluetooth 2>/dev/null || echo "    bluetooth enable failed"

# 9. Write .desktop file
write_desktop_file
command -v update-desktop-database >/dev/null 2>&1 && \
    update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true

# 10. Final
xdg-user-dirs-update 2>/dev/null || true

echo ""
echo "════════════════════════════════════════════════════════════"
echo "  V4 INSTALL COMPLETE — ACTION REQUIRED"
echo "════════════════════════════════════════════════════════════"
echo ""
echo "  STEP 1: LOG OUT and LOG BACK IN (turnstile needs fresh session)."
echo "  STEP 2: Verify: ls -d /run/turnstiled"
echo "  STEP 3: Enable user audio services (no sudo):"
echo "          dinitctl enable pipewire"
echo "          dinitctl enable pipewire-pulse"
echo "          dinitctl enable wireplumber"
echo "  STEP 4: Verify: dinitctl list  (look for {+} on pipewire, etc.)"
echo "  STEP 5: setwal ~/Pictures/Wallpapers/<image> && startx"
echo ""
echo "  Re-running this script will skip install and only refresh"
echo "  ~/.local/share/applications/vxwm.desktop"
echo "════════════════════════════════════════════════════════════"
