#!/usr/bin/env bash
# ==============================================================================
# OXWM Direct Installer (v8 - Network Retry & Error Checking)
# ==============================================================================

set -Eeuo pipefail

echo "=================================================="
echo "    [v8] Installing OXWM (Directly from GitHub)   "
echo "=================================================="

# 1. Ensure base dependencies are installed
echo "==> [v8] Installing required build dependencies..."
sudo pacman -S --needed --noconfirm base-devel git libx11 libxft freetype2 fontconfig libxinerama wget tar

# 2. Setup a temporary workspace
TEMP_DIR=$(mktemp -d)
cd "$TEMP_DIR"

# 3. Download the specific Zig version
echo "==> [v8] Downloading compatible Zig compiler (0.14.0)..."
# Added --tries=3 and --timeout to prevent silent failures
if ! wget -q --tries=3 --timeout=15 https://ziglang.org/download/0.14.0/zig-linux-x86_64-0.14.0.tar.xz; then
    echo "    [!] ERROR: Failed to download Zig compiler. Check your internet connection."
    exit 1
fi
tar -xf zig-linux-x86_64-0.14.0.tar.xz
ZIG_BIN="$TEMP_DIR/zig-linux-x86_64-0.14.0/zig"

# 4. Pre-download Lua
echo "==> [v8] Pre-downloading Lua 5.4.8..."
LUA_URL="https://www.lua.org/ftp/lua-5.4.8.tar.gz"
if ! wget -q --tries=3 --timeout=15 "$LUA_URL" -O lua-5.4.8.tar.gz; then
    echo "    [!] ERROR: Failed to download Lua. Check your internet connection."
    exit 1
fi

# 5. Clone OXWM
echo "==> [v8] Cloning OXWM from Tony's GitHub..."
if ! git clone https://github.com/tonybanters/oxwm.git; then
    echo "    [!] ERROR: Failed to clone OXWM repository."
    exit 1
fi
cd oxwm

# 6. PATCH THE BUILD SYSTEM (Point to local file)
echo "==> [v8] Patching build.zig.zon to use local Lua file..."
LUA_PATH="$TEMP_DIR/lua-5.4.8.tar.gz"
sed -i "s|.url = \"https://www.lua.org/ftp/lua-5.4.8.tar.gz\",|.path = \"$LUA_PATH\",|" build.zig.zon

# 7. Compile and Install
echo "==> [v8] Compiling OXWM using Zig (ReleaseFast)..."
# If the compile fails, we want to know
if ! "$ZIG_BIN" build -Doptimize=ReleaseFast --prefix /usr; then
    echo "    [!] ERROR: Compilation failed."
    exit 1
fi

# 8. Cleanup
echo "==> [v8] Cleaning up temporary build files..."
cd ~
rm -rf "$TEMP_DIR"

# 9. Setup default configuration folder
echo "==> [v8] Setting up OXWM configuration..."
mkdir -p ~/.config/oxwm

if command -v oxwm &> /dev/null; then
    oxwm --init 2>/dev/null || echo "    [!] Default config will be created on first launch."
else
    echo "    [!] ERROR: OXWM binary not found in PATH after compilation."
    exit 1
fi

echo ""
echo "=================================================="
echo "  [v8] OXWM Installed Successfully!               "
echo "=================================================="
echo ""
echo "  To start OXWM, add 'exec oxwm' to your ~/.xinitrc"
echo "  and run 'startx', or select it from your display manager."
echo ""
echo "  Your configuration is at: ~/.config/oxwm/config.lua"
echo "  Reload config with: Super + Shift + R"
echo "=================================================="