#!/usr/bin/env bash
# ==============================================================================
# OXWM Direct Installer (v7 - Local Path Patch)
# ==============================================================================

set -Eeuo pipefail

echo "=================================================="
echo "    [v7] Installing OXWM (Directly from GitHub)   "
echo "=================================================="

# 1. Ensure base dependencies are installed
echo "==> [v7] Installing required build dependencies..."
sudo pacman -S --needed --noconfirm base-devel git libx11 libxft freetype2 fontconfig libxinerama wget tar

# 2. Setup a temporary workspace
TEMP_DIR=$(mktemp -d)
cd "$TEMP_DIR"

# 3. Download the specific Zig version
echo "==> [v7] Downloading compatible Zig compiler (0.14.0)..."
wget -q https://ziglang.org/download/0.14.0/zig-linux-x86_64-0.14.0.tar.xz
tar -xf zig-linux-x86_64-0.14.0.tar.xz
ZIG_BIN="$TEMP_DIR/zig-linux-x86_64-0.14.0/zig"

# 4. Pre-download Lua
echo "==> [v7] Pre-downloading Lua 5.4.8..."
LUA_URL="https://www.lua.org/ftp/lua-5.4.8.tar.gz"
wget -q "$LUA_URL" -O lua-5.4.8.tar.gz

# 5. Clone OXWM
echo "==> [v7] Cloning OXWM from Tony's GitHub..."
git clone https://github.com/tonybanters/oxwm.git
cd oxwm

# 6. PATCH THE BUILD SYSTEM (Point to local file)
echo "==> [v7] Patching build.zig.zon to use local Lua file..."
# The original line looks like: .url = "https://www.lua.org/ftp/lua-5.4.8.tar.gz",
# We replace the URL with the absolute path to our downloaded file.
LUA_PATH="$TEMP_DIR/lua-5.4.8.tar.gz"
sed -i "s|.url = \"https://www.lua.org/ftp/lua-5.4.8.tar.gz\",|.path = \"$LUA_PATH\",|" build.zig.zon

# 7. Compile and Install
echo "==> [v7] Compiling OXWM using Zig (ReleaseFast)..."
"$ZIG_BIN" build -Doptimize=ReleaseFast --prefix /usr

# 8. Cleanup
echo "==> [v7] Cleaning up temporary build files..."
cd ~
rm -rf "$TEMP_DIR"

# 9. Setup default configuration folder
echo "==> [v7] Setting up OXWM configuration..."
mkdir -p ~/.config/oxwm

if command -v oxwm &> /dev/null; then
    oxwm --init 2>/dev/null || echo "    [!] Default config will be created on first launch."
else
    echo "    [!] ERROR: OXWM binary not found in PATH after compilation."
    exit 1
fi

echo ""
echo "=================================================="
echo "  [v7] OXWM Installed Successfully!               "
echo "=================================================="
echo ""
echo "  To start OXWM, add 'exec oxwm' to your ~/.xinitrc"
echo "  and run 'startx', or select it from your display manager."
echo ""
echo "  Your configuration is at: ~/.config/oxwm/config.lua"
echo "  Reload config with: Super + Shift + R"
echo "=================================================="