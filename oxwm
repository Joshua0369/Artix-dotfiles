#!/usr/bin/env bash
# ==============================================================================
# OXWM Direct Installer (Auto-fixes Zig Version & Lua Download Bug)
# ==============================================================================

set -Eeuo pipefail

echo "=================================================="
echo "    Installing OXWM (Directly from GitHub)        "
echo "=================================================="

# 1. Ensure base dependencies are installed
echo "==> Installing required build dependencies..."
sudo pacman -S --needed --noconfirm base-devel git libx11 libxft freetype2 fontconfig libxinerama wget tar

# 2. Setup a temporary workspace
TEMP_DIR=$(mktemp -d)
cd "$TEMP_DIR"

# 3. Download the specific Zig version
echo "==> Downloading compatible Zig compiler (0.14.0)..."
wget -q https://ziglang.org/download/0.14.0/zig-linux-x86_64-0.14.0.tar.xz
tar -xf zig-linux-x86_64-0.14.0.tar.xz
ZIG_BIN="$TEMP_DIR/zig-linux-x86_64-0.14.0/zig"

# 4. Pre-download Lua to bypass Zig's network bug
echo "==> Pre-downloading Lua 5.4.8 to prevent Zig network errors..."
LUA_URL="https://www.lua.org/ftp/lua-5.4.8.tar.gz"
wget -q "$LUA_URL" -O lua-5.4.8.tar.gz

# Zig requires the file to be cached with a specific hash name
# The hash for Lua 5.4.8 is: 4f18ddae154e793e46eeab727c59ef1c0c0c2b744e7b94219710d76f530629ae
LUA_HASH="12204f18ddae154e793e46eeab727c59ef1c0c0c2b744e7b94219710d76f530629ae"
ZIG_CACHE_DIR="$HOME/.cache/zig/p"

mkdir -p "$ZIG_CACHE_DIR"
cp lua-5.4.8.tar.gz "$ZIG_CACHE_DIR/$LUA_HASH"

# 5. Clone and Build
echo "==> Cloning OXWM from Tony's GitHub..."
git clone https://github.com/tonybanters/oxwm.git
cd oxwm

echo "==> Compiling OXWM using Zig (ReleaseFast)..."
# Use the downloaded Zig binary
"$ZIG_BIN" build -Doptimize=ReleaseFast --prefix /usr

# 6. Cleanup
echo "==> Cleaning up temporary build files..."
cd ~
rm -rf "$TEMP_DIR"

# 7. Setup default configuration folder
echo "==> Setting up OXWM configuration..."
mkdir -p ~/.config/oxwm

# Generate the default config if the binary supports it
if command -v oxwm &> /dev/null; then
    oxwm --init 2>/dev/null || echo "    [!] Default config will be created on first launch."
else
    echo "    [!] ERROR: OXWM binary not found in PATH after compilation."
    exit 1
fi

echo ""
echo "=================================================="
echo "  OXWM Installed Successfully!                    "
echo "=================================================="
echo ""
echo "  To start OXWM, add 'exec oxwm' to your ~/.xinitrc"
echo "  and run 'startx', or select it from your display manager."
echo ""
echo "  Your configuration is at: ~/.config/oxwm/config.lua"
echo "  Reload config with: Super + Shift + R"
echo "=================================================="