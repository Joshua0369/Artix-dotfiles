#!/usr/bin/env bash
# ==============================================================================
# OXWM Installer (v16 - AUR makepkg Method)
# ==============================================================================

set -Eeuo pipefail

echo "=================================================="
echo "    [v16] Installing OXWM (via AUR Package)       "
echo "=================================================="

# 1. Install base dependencies and build tools
echo "==> [v16] Installing required dependencies..."
sudo pacman -S --needed --noconfirm base-devel git libx11 libxft freetype2 fontconfig libxinerama zig lua

# 2. Setup a temporary workspace
TEMP_DIR=$(mktemp -d)
cd "$TEMP_DIR"

# 3. Clone the AUR package (This handles the complex build logic for you)
echo "==> [v16] Downloading AUR package for oxwm-git..."
# We use the official AUR git URL
if ! git clone https://aur.archlinux.org/oxwm-git.git; then
    echo "    [!] ERROR: Failed to clone AUR repository."
    exit 1
fi

cd oxwm-git

# 4. Build and install using makepkg
echo "==> [v16] Compiling and installing OXWM via makepkg..."
# -s installs missing dependencies, -i installs the package, --noconfirm skips prompts
if ! makepkg -si --noconfirm; then
    echo "    [!] ERROR: Compilation failed."
    exit 1
fi

# 5. Cleanup
echo "==> [v16] Cleaning up temporary build files..."
cd ~
rm -rf "$TEMP_DIR"

# 6. Setup default configuration folder
echo "==> [v16] Setting up OXWM configuration..."
mkdir -p ~/.config/oxwm

if command -v oxwm &> /dev/null; then
    oxwm --init 2>/dev/null || echo "    [!] Default config will be created on first launch."
else
    echo "    [!] ERROR: OXWM binary not found in PATH after compilation."
    exit 1
fi

echo ""
echo "=================================================="
echo "  [v16] OXWM Installed Successfully!              "
echo "=================================================="
echo ""
echo "  To start OXWM, add 'exec oxwm' to your ~/.xinitrc"
echo "  and run 'startx', or select it from your display manager."
echo ""
echo "  Your configuration is at: ~/.config/oxwm/config.lua"
echo "  Reload config with: Super + Shift + R"
echo "=================================================="