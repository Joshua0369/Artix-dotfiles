#!/usr/bin/env bash
# ==============================================================================
# OXWM Direct Installer (v13 - System Lua Link)
# ==============================================================================

set -Eeuo pipefail

echo "=================================================="
echo "    [v13] Installing OXWM (Directly from GitHub)  "
echo "=================================================="

# 1. Ensure base dependencies are installed (including system Lua)
echo "==> [v13] Installing required build dependencies..."
sudo pacman -S --needed --noconfirm base-devel git libx11 libxft freetype2 fontconfig libxinerama wget tar lua

# 2. Setup a temporary workspace
TEMP_DIR=$(mktemp -d)
cd "$TEMP_DIR"

# 3. Download the specific Zig version
echo "==> [v13] Downloading compatible Zig compiler (0.14.0)..."
if ! wget -q --tries=3 --timeout=15 https://ziglang.org/download/0.14.0/zig-linux-x86_64-0.14.0.tar.xz; then
    echo "    [!] ERROR: Failed to download Zig compiler."
    exit 1
fi
tar -xf zig-linux-x86_64-0.14.0.tar.xz
ZIG_BIN="$TEMP_DIR/zig-linux-x86_64-0.14.0/zig"

# 4. Clone OXWM
echo "==> [v13] Cloning OXWM from Tony's GitHub..."
if ! git clone https://github.com/tonybanters/oxwm.git; then
    echo "    [!] ERROR: Failed to clone OXWM repository."
    exit 1
fi
cd oxwm

# 5. PATCH THE BUILD SYSTEM
# Instead of trying to force Zig to read a tar.gz, we remove the dependency entirely 
# and link the system Lua library.
echo "==> [v13] Patching build files to use system Lua..."

# Remove the lua dependency block from build.zig.zon
# This searches for the lua block and deletes it
sed -i '/\.lua = \./,/},/d' build.zig.zon

# Modify build.zig to link system lua instead of the dependency
sed -i 's/const lua_dep = b.dependency("lua", \.{.*});//' build.zig
sed -i 's/exe.linkLibrary(lua_dep.artifact("lua"));/exe.linkSystemLibrary("lua5.4");/' build.zig

# 6. Compile and Install
echo "==> [v13] Compiling OXWM using Zig (ReleaseFast)..."
if ! "$ZIG_BIN" build -Doptimize=ReleaseFast --prefix /usr; then
    echo "    [!] ERROR: Compilation failed."
    exit 1
fi

# 7. Cleanup
echo "==> [v13] Cleaning up temporary build files..."
cd ~
rm -rf "$TEMP_DIR"

# 8. Setup default configuration folder
echo "==> [v13] Setting up OXWM configuration..."
mkdir -p ~/.config/oxwm

if command -v oxwm &> /dev/null; then
    oxwm --init 2>/dev/null || echo "    [!] Default config will be created on first launch."
else
    echo "    [!] ERROR: OXWM binary not found in PATH after compilation."
    exit 1
fi

echo ""
echo "=================================================="
echo "  [v13] OXWM Installed Successfully!              "
echo "=================================================="
echo ""
echo "  To start OXWM, add 'exec oxwm' to your ~/.xinitrc"
echo "  and run 'startx', or select it from your display manager."
echo ""
echo "  Your configuration is at: ~/.config/oxwm/config.lua"
echo "  Reload config with: Super + Shift + R"
echo "=================================================="