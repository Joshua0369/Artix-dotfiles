#!/usr/bin/env bash
# ==============================================================================
# OXWM Installer (v18 - Zig 0.14.0 + Local File Override)
# ==============================================================================

set -Eeuo pipefail

echo "=================================================="
echo "    [v18] Installing OXWM (Zig 0.14.0 + Local Lua)"
echo "=================================================="

# 1. Install base dependencies
echo "==> [v18] Installing required dependencies..."
sudo pacman -S --needed --noconfirm base-devel git libx11 libxft freetype2 fontconfig libxinerama wget tar

# 2. Setup temporary workspace
TEMP_DIR=$(mktemp -d)
cd "$TEMP_DIR"

# 3. Download the specific Zig version (0.14.0) that still has b.args
echo "==> [v18] Downloading compatible Zig compiler (0.14.0)..."
if ! wget -q --tries=3 --timeout=15 https://ziglang.org/download/0.14.0/zig-linux-x86_64-0.14.0.tar.xz; then
    echo "    [!] ERROR: Failed to download Zig compiler."
    exit 1
fi
tar -xf zig-linux-x86_64-0.14.0.tar.xz
ZIG_BIN="$TEMP_DIR/zig-linux-x86_64-0.14.0/zig"

# 4. Download Lua from reliable mirror
echo "==> [v18] Downloading Lua 5.4.8 from mirror..."
LUA_MIRROR="http://mirror.techfak.net/ubuntu/pool/main/l/lua5.4/lua5.4_5.4.8.orig.tar.gz"
if ! wget -q --tries=3 --timeout=20 "$LUA_MIRROR" -O "$TEMP_DIR/lua-5.4.8.tar.gz"; then
    echo "    [!] ERROR: Failed to download Lua."
    exit 1
fi

# 5. Clone OXWM
echo "==> [v18] Cloning OXWM from Tony's GitHub..."
if ! git clone https://github.com/tonybanters/oxwm.git; then
    echo "    [!] ERROR: Failed to clone OXWM repository."
    exit 1
fi
cd oxwm

# 6. Patch build.zig.zon to point to local file using file:// URI
echo "==> [v18] Patching build.zig.zon to use local Lua file..."
# Replace the https:// URL with file:// pointing to our downloaded tarball
sed -i "s|.url = \"https://www.lua.org/ftp/lua-5.4.8.tar.gz\",|.url = \"file://$TEMP_DIR/lua-5.4.8.tar.gz\",|" build.zig.zon

# 7. Compile
echo "==> [v18] Compiling OXWM using Zig 0.14.0 (ReleaseFast)..."
if ! "$ZIG_BIN" build -Doptimize=ReleaseFast --prefix /usr; then
    echo "    [!] ERROR: Compilation failed."
    exit 1
fi

# 8. Cleanup
echo "==> [v18] Cleaning up..."
cd ~
rm -rf "$TEMP_DIR"

# 9. Setup configuration
echo "==> [v18] Setting up OXWM configuration..."
mkdir -p ~/.config/oxwm

if command -v oxwm &> /dev/null; then
    oxwm --init 2>/dev/null || echo "    [!] Default config will be created on first launch."
else
    echo "    [!] ERROR: OXWM binary not found."
    exit 1
fi

echo ""
echo "=================================================="
echo "  [v18] OXWM Installed Successfully!              "
echo "=================================================="
echo ""
echo "  To start OXWM, add 'exec oxwm' to your ~/.xinitrc"
echo "  and run 'startx', or select it from your display manager."
echo ""
echo "  Your configuration is at: ~/.config/oxwm/config.lua"
echo "  Reload config with: Super + Shift + R"
echo "=================================================="