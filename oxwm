#!/usr/bin/env bash
# ==============================================================================
# OXWM Installer (v19 - AUR Package Method)
# ==============================================================================

set -Eeuo pipefail

echo "=================================================="
echo "    [v19] Installing OXWM (via AUR Package)       "
echo "=================================================="

# 1. Install base dependencies
echo "==> [v19] Installing required dependencies..."
sudo pacman -S --needed --noconfirm base-devel git

# 2. Setup temporary workspace
TEMP_DIR=$(mktemp -d)
cd "$TEMP_DIR"

# 3. Clone the AUR package
echo "==> [v19] Downloading AUR package for oxwm-git..."
if ! git clone https://aur.archlinux.org/oxwm-git.git; then
    echo "    [!] ERROR: Failed to clone AUR repository."
    exit 1
fi

cd oxwm-git

# 4. Build and install using makepkg
echo "==> [v19] Compiling and installing OXWM via makepkg..."
if ! makepkg -si --noconfirm; then
    echo "    [!] ERROR: Compilation failed."
    exit 1
fi

# 5. Cleanup
echo "==> [v19] Cleaning up..."
cd ~
rm -rf "$TEMP_DIR"

# 6. Setup configuration
echo "==> [v19] Setting up OXWM configuration..."
mkdir -p ~/.config/oxwm

if command -v oxwm &> /dev/null; then
    oxwm --init 2>/dev/null || echo "    [!] Default config will be created on first launch."
else
    echo "    [!] ERROR: OXWM binary not found."
    exit 1
fi

echo ""
echo "=================================================="
echo "  [v19] OXWM Installed Successfully!              "
echo "=================================================="
echo ""
echo "  To start OXWM, add 'exec oxwm' to your ~/.xinitrc"
echo "  and run 'startx', or select it from your display manager."
echo ""
echo "  Your configuration is at: ~/.config/oxwm/config.lua"
echo "  Reload config with: Super + Shift + R"
echo "=================================================="