#!/usr/bin/env bash
# ==============================================================================
# OXWM Direct Installer (System Lua Bypass for Zig TLS Bug)
# ==============================================================================

set -Eeuo pipefail

echo "=================================================="
echo "    Installing OXWM (Directly from GitHub)        "
echo "=================================================="

# 1. Install dependencies, INCLUDING system Lua
echo "==> Installing required build dependencies (and Lua)..."
sudo pacman -S --needed --noconfirm base-devel git libx11 libxft freetype2 fontconfig libxinerama wget tar lua

# 2. Setup a temporary workspace
TEMP_DIR=$(mktemp -d)
cd "$TEMP_DIR"

# 3. Download the specific Zig version
echo "==> Downloading compatible Zig compiler (0.14.0)..."
wget -q https://ziglang.org/download/0.14.0/zig-linux-x86_64-0.14.0.tar.xz
tar -xf zig-linux-x86_64-0.14.0.tar.xz
ZIG_BIN="$TEMP_DIR/zig-linux-x86_64-0.14.0/zig"

# 4. Clone OXWM
echo "==> Cloning OXWM from Tony's GitHub..."
git clone https://github.com/tonybanters/oxwm.git
cd oxwm

# 5. PATCH THE BUILD SYSTEM
# Zig's downloader is broken (TlsInitializationFailed). 
# We will remove the external Lua dependency and use the system one instead.
echo "==> Patching build files to use system Lua..."

# Remove the dependency from build.zig.zon
sed -i '/lua-5.4.8.tar.gz/,+2d' build.zig.zon

# Find the line in build.zig that links the downloaded Lua and change it to link the system Lua
# (The exact line varies by version, but it usually looks like exe.linkLibrary(lua_dep) or similar)
# We will replace the lua dependency inclusion with a system link.
sed -i 's/const lua = b.dependency("lua", .{.*});//' build.zig
sed -i 's/exe.linkLibrary(lua.artifact("lua"));/exe.linkSystemLibrary("lua5.4");/' build.zig

# 6. Compile and Install
echo "==> Compiling OXWM using Zig (ReleaseFast)..."
"$ZIG_BIN" build -Doptimize=ReleaseFast --prefix /usr

# 7. Cleanup
echo "==> Cleaning up temporary build files..."
cd ~
rm -rf "$TEMP_DIR"

# 8. Setup default configuration folder
echo "==> Setting up OXWM configuration..."
mkdir -p ~/.config/oxwm

if command -v oxwm &> /dev/null; then
    oxwm --init 2>/dev/null || echo "    [!] Default config will be created on first launch."
else
    echo "    [!] ERROR: OXWM binary not found in PATH after compilation."
    exit 1
fi

echo ""
echo "=================================================="
echo "  OXWM Installed Successfully!                    "
echo "=================================================="
echo ""
echo "  To start OXWM, add 'exec oxwm' to your ~/.xinitrc"
echo "  and run 'startx', or select it from your display manager."
echo ""
echo "  Your configuration is at: ~/.config/oxwm/config.lua"
echo "  Reload config with: Super + Shift + R"
echo "=================================================="